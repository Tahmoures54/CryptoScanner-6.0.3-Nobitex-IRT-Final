# CryptoScanner 6.0.1 environment template
# Copy to .env or set these variables in the OS environment.

# CoinMarketCap Pro API key
CRYPTOSCANNER_CMC_KEY=

# Nobitex API key pair (public key + Ed25519 private key)
# Put this value in the application Bot/Exchange settings as API Key,
# or expose it as CRYPTOSCANNER_NOBITEX_TOKEN for your deployment wrapper.
CRYPTOSCANNER_NOBITEX_TOKEN=

# Application data directory (optional)
# CRYPTOSCANNER_APPDATA=
