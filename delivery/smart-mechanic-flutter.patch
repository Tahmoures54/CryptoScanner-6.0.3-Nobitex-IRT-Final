--- /dev/null
+++ b/tool/apply_brand_icons.py
@@ -0,0 +1,93 @@
+#!/usr/bin/env python3
+"""Generate launcher, splash and branding assets from the root logo.png."""
+from __future__ import annotations
+
+from pathlib import Path
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[1]
+SRC = ROOT / "logo.png"
+BRAND = ROOT / "assets" / "branding"
+RES = ROOT / "android" / "app" / "src" / "main" / "res"
+BG = (13, 13, 18, 255)  # #0D0D12
+
+
+def scale_mark(img: Image.Image, inner: int) -> Image.Image:
+    mark = img.convert("RGBA")
+    if mark.width == 0 or mark.height == 0:
+        return mark
+    ratio = min(inner / mark.width, inner / mark.height)
+    new_size = (max(1, int(mark.width * ratio)), max(1, int(mark.height * ratio)))
+    return mark.resize(new_size, Image.Resampling.LANCZOS)
+
+
+def fit_square(img: Image.Image, size: int, padding_ratio: float = 0.08) -> Image.Image:
+    canvas = Image.new("RGBA", (size, size), BG)
+    inner = int(size * (1 - padding_ratio * 2))
+    mark = scale_mark(img, inner)
+    x = (size - mark.width) // 2
+    y = (size - mark.height) // 2
+    canvas.alpha_composite(mark, (x, y))
+    return canvas
+
+
+def adaptive_foreground(img: Image.Image, size: int = 1024) -> Image.Image:
+    """Safe-zone padding so the circular mark survives adaptive-icon crop."""
+    canvas = Image.new("RGBA", (size, size), (0, 0, 0, 0))
+    inner = int(size * 0.72)
+    mark = scale_mark(img, inner)
+    x = (size - mark.width) // 2
+    y = (size - mark.height) // 2
+    canvas.alpha_composite(mark, (x, y))
+    return canvas
+
+
+def splash_mark(img: Image.Image, size: int = 512) -> Image.Image:
+    canvas = Image.new("RGBA", (size, size), (0, 0, 0, 0))
+    inner = int(size * 0.88)
+    mark = scale_mark(img, inner)
+    x = (size - mark.width) // 2
+    y = (size - mark.height) // 2
+    canvas.alpha_composite(mark, (x, y))
+    return canvas
+
+
+def save(img: Image.Image, path: Path) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    img.save(path, "PNG", optimize=True)
+    print(f"wrote {path.relative_to(ROOT)} {img.size}")
+
+
+def main() -> None:
+    if not SRC.exists():
+        raise SystemExit(f"missing source logo: {SRC}")
+    src = Image.open(SRC).convert("RGBA")
+
+    mark = fit_square(src, 1024, padding_ratio=0.04)
+    save(mark, BRAND / "mark.png")
+    save(mark, BRAND / "logo.png")
+    save(fit_square(src, 1024, padding_ratio=0.06), BRAND / "app_icon.png")
+    save(adaptive_foreground(src), BRAND / "app_icon_foreground.png")
+    save(adaptive_foreground(src), BRAND / "adaptive_icon.png")
+    save(splash_mark(src, 512), BRAND / "splash_mark.png")
+
+    mipmap = {
+        "mipmap-mdpi": 48,
+        "mipmap-hdpi": 72,
+        "mipmap-xhdpi": 96,
+        "mipmap-xxhdpi": 144,
+        "mipmap-xxxhdpi": 192,
+    }
+    for folder, size in mipmap.items():
+        icon = fit_square(src, size, padding_ratio=0.04)
+        save(icon, RES / folder / "ic_launcher.png")
+        save(icon, RES / folder / "ic_launcher_round.png")
+
+    save(adaptive_foreground(src, 432), RES / "drawable" / "ic_launcher_foreground.png")
+    save(splash_mark(src, 384), RES / "drawable" / "splash_logo.png")
+    save(splash_mark(src, 576), RES / "drawable-xxhdpi" / "splash_logo.png")
+
+
+if __name__ == "__main__":
+    main()
