+  min-height: 100vh;
+  padding: 48px 20px 64px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+}
+
+.hero {
+  text-align: center;
+  max-width: 640px;
+  margin-bottom: 36px;
+}
+
+.hero h1 {
+  margin: 16px 0 4px;
+  font-size: 2rem;
+  color: #ffc107;
+}
+
+.slogan {
+  margin: 0 0 16px;
+  color: #ff9800;
+  font-weight: 700;
+}
+
+.lede {
+  color: #b0b0c0;
+  line-height: 1.8;
+}
+
+.grid {
+  display: grid;
+  gap: 16px;
+  width: 100%;
+  max-width: 880px;
+  grid-template-columns: 1fr;
+}
+
+@media (min-width: 800px) {
+  .grid {
+    grid-template-columns: 1.4fr 0.8fr;
+  }
+}
+
+.card {
+  background: #1a1a24;
+  border: 1px solid rgba(255, 193, 7, 0.28);
+  border-radius: 16px;
+  padding: 24px;
+}
+
+.card h2 {
+  margin: 0 0 16px;
+  color: #ffb300;
+  font-size: 1.15rem;
+}
+
+.card ul {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.card li {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+
+code {
+  color: #ffd54f;
+  background: #0d0d12;
+  padding: 2px 6px;
+  border-radius: 6px;
+  font-size: 0.85rem;
+  width: fit-content;
+}
+
+.card li span {
+  color: #b0b0c0;
+  font-size: 0.9rem;
+}
+
+.status {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  color: #81c784;
+}
+
+.dot {
+  width: 10px;
+  height: 10px;
+  border-radius: 50%;
+  background: #4caf50;
+  box-shadow: 0 0 10px #4caf50;
+}
+
+.links {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  margin-top: 16px;
+}
+
+.links a {
+  color: #ffb300;
+}
