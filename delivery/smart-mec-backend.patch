       const history = await db.query.diagnostics.findMany({
         where: eq(diagnostics.userId, user.id),
@@ -64,8 +72,8 @@ export async function GET(request: NextRequest) {
 
       return NextResponse.json({
         success: true,
-        data: history,
-        pagination: { limit, offset },
+        data: history.map(enrichHistoryItem),
+        pagination: { limit, offset, page: page >= 1 ? page : undefined },
       });
     }
 
@@ -388,3 +396,36 @@ export async function POST(request: NextRequest) {
     return handleError(error);
   }
 }
+
+function enrichHistoryItem(row: typeof diagnostics.$inferSelect) {
+  const stored = row.carId || '';
+  let carId = stored;
+  let carName: string | null = null;
+  let carYear: string | null = null;
+
+  if (stored.startsWith('custom:')) {
+    const parts = stored.split(':');
+    carId = 'custom';
+    carName = parts[1] || null;
+    carYear = parts.slice(2).join(':') || null;
+  } else if (stored.includes(':')) {
+    const [id, ...rest] = stored.split(':');
+    carId = id;
+    carYear = rest.join(':') || null;
+    const car = (carsData as Car[]).find((c) => c.id.toString() === id);
+    if (car) carName = `${car.brand} ${car.model}`.trim();
+  } else {
+    const car = (carsData as Car[]).find((c) => c.id.toString() === stored);
+    if (car) carName = `${car.brand} ${car.model}`.trim();
+  }
+
+  return {
+    ...row,
+    id: String(row.id),
+    carId,
+    carName,
+    carYear,
+    createdAt:
+      row.createdAt instanceof Date ? row.createdAt.toISOString() : row.createdAt,
+  };
+}
